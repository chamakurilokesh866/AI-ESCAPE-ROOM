# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# --- Version 2 only ---------------------------------------------------------
# Model to try when the main one is overloaded (503/429) or not available (404).
# Set to "none" to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# How many times to retry a temporary error (with exponential backoff: 0.5s, 1s, 2s, ...)
GEMINI_MAX_RETRIES=2

# "fast" (default): ask each model for its lowest thinking level (much quicker replies).
# "default": let the model think as much as it normally does.
GEMINI_THINKING=fast
